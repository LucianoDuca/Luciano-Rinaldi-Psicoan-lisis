# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# URL pública del sitio (canonical, sitemap y robots). Cambiar si se usa dominio propio.
SITE_URL=https://www.lucianorinaldi.com

# --- Email de las consultas (Resend) ---
# Sin estos dos datos el sitio funciona igual: las consultas solo se guardan
# en data/submissions.json (que en Render Free se borra al reiniciar).
RESEND_API_KEY=
# Email donde llegan las consultas. Sin dominio verificado en Resend tiene que
# ser el mismo email con el que se creó la cuenta de Resend.
CONTACT_TO=
# Remitente (opcional). Por defecto: Web Luciano Rinaldi <onboarding@resend.dev>
CONTACT_FROM=

# --- Anti-bot ---
# Clave para firmar los tokens del formulario. Si se deja vacía se genera una
# al arrancar (funciona igual). En Render se puede usar "Generate".
FORM_SECRET=
