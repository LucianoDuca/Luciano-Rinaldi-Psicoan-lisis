# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# --- Email (opcional) ---
# Completá estos datos para que las consultas del formulario lleguen por mail.
# Si los dejás vacíos, las consultas igual se guardan en data/submissions.json
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente que verá el destinatario (por defecto usa SMTP_USER)
SMTP_FROM=
# A qué correo llegan las consultas (el mail de Luciano)
CONTACT_TO=
